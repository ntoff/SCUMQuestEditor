<Window x:Class="SCUMQuestEditor.ColorSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Appearance Settings" Height="720" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Theme Toggle -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Light Mode" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource MaterialDesignBody}" FontSize="13"/>
                    <ToggleButton x:Name="TglDarkMode" Width="48" Height="24" Margin="0,0,12,0"
                                  IsChecked="True" Background="#424242"
                                  Checked="TglDarkMode_Checked" Unchecked="TglDarkMode_Unchecked"
                                  Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="PART_Background" Background="#424242" CornerRadius="12"
                                        IsHitTestVisible="True" Cursor="Hand">
                                    <Ellipse x:Name="Dot" Width="18" Height="18" Fill="White"
                                             HorizontalAlignment="Right" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="DotOffset" X="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="PART_Background" Property="Background" Value="#424242"/>
                                        <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Dot" Property="Margin" Value="0,0,3,0"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="PART_Background" Property="Background" Value="#FFA000"/>
                                        <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="Dot" Property="Margin" Value="3,0,0,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="Dark Mode" VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Color Swatches -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Primary Color Section -->
                    <TextBlock Text="Primary Color (Main Buttons, Highlights)" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <ListBox x:Name="PrimarySwatches" Margin="0,0,0,16" SelectionMode="Single" SelectionChanged="OnSwatchSelectionChanged"
                             Style="{StaticResource {x:Type ListBox}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SwatchBorder" Width="32" Height="32" CornerRadius="3" Margin="0,0,2,2"
                                        BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" Padding="0">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Reset to Default" Click="ResetPrimaryToDefault"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Brush.Color}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Secondary Color Section -->
                    <TextBlock Text="Secondary Color (Subtle Buttons, Accents)" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <ListBox x:Name="SecondarySwatches" Margin="0,0,0,16" SelectionMode="Single" SelectionChanged="OnSwatchSelectionChanged"
                             Style="{StaticResource {x:Type ListBox}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SwatchBorder" Width="32" Height="32" CornerRadius="3" Margin="0,0,2,2"
                                        BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" Padding="0">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Reset to Default" Click="ResetSecondaryToDefault"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Brush.Color}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Error Highlight Section -->
                    <TextBlock Text="JSON Error Highlight (Warnings &amp; Errors)" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <ListBox x:Name="ErrorSwatches" SelectionMode="Single" SelectionChanged="OnSwatchSelectionChanged"
                             Style="{StaticResource {x:Type ListBox}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SwatchBorder" Width="32" Height="32" CornerRadius="3" Margin="0,0,2,2"
                                        BorderThickness="3" BorderBrush="Transparent" Cursor="Hand" Padding="0">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Reset to Default" Click="ResetErrorToDefault"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Brush.Color}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnApply" Content="Apply" Margin="0,0,10,0"
                        Click="BtnApply_Click" Style="{StaticResource SubtleButton}"/>
                <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0"
                        Click="BtnOk_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,10,0"
                        Click="BtnCancel_Click" Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
