<Window x:Class="SCUMQuestEditor.ColorSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Appearance Settings" Height="720" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview Card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Current Colors" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="PrimaryColorSwatch" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtPrimaryPreview" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="SecondaryColorSwatch" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtSecondaryPreview" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border x:Name="ErrorColorSwatch" Width="32" Height="32" CornerRadius="6" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TxtErrorPreview" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Primary Color Section -->
            <Border Grid.Row="1" Margin="0,16,0,0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Primary Color (Main Buttons, Highlights)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="PrimarySwatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="PrimarySwatchBorder" Width="48" Height="48" CornerRadius="6" Margin="0,0,6,6"
                                            BorderThickness="2" Cursor="Hand" Padding="0" MouseLeftButtonDown="OnPrimarySwatchClick">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Reset to Default" Click="ResetPrimaryToDefault"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Brush.Color}"/>
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Secondary Color (Subtle Buttons, Accents)" FontWeight="SemiBold" Margin="0,24,0,8"/>
                        <ItemsControl x:Name="SecondarySwatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SecondarySwatchBorder" Width="48" Height="48" CornerRadius="6" Margin="0,0,6,6"
                                            BorderThickness="2" Cursor="Hand" Padding="0" MouseLeftButtonDown="OnSecondarySwatchClick">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Reset to Default" Click="ResetSecondaryToDefault"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Brush.Color}"/>
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="JSON Error Highlight (Warnings &amp; Errors)" FontWeight="SemiBold" Margin="0,24,0,8"/>
                        <ItemsControl x:Name="ErrorSwatches">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ErrorSwatchBorder" Width="48" Height="48" CornerRadius="6" Margin="0,0,6,6"
                                            BorderThickness="2" Cursor="Hand" Padding="0" MouseLeftButtonDown="OnErrorSwatchClick">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Reset to Default" Click="ResetErrorToDefault"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Brush.Color}"/>
                                        </Border.Background>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnApply" Content="Apply" Margin="0,0,10,0"
                        Click="BtnApply_Click" Style="{StaticResource SubtleButton}"/>
                <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0"
                        Click="BtnOk_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,10,0"
                        Click="BtnCancel_Click" Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
