<Window x:Class="SCUMQuestEditor.EditRequiredItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Required Items" Height="800" Width="900" MinHeight="600" MinWidth="800" MaxWidth="1200" MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

            <!-- Top ListView -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8,8,8,4" Padding="0">
                <ListView x:Name="LvRequiredItems" Margin="4" Style="{StaticResource MaterialDesignListView}"
                          SelectionMode="Multiple" BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Accepted Items" DisplayMemberBinding="{Binding AcceptedItemsDisplay}" />
                            <GridViewColumn Header="Required Num" DisplayMemberBinding="{Binding RequiredNum}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,8">
                <Button x:Name="BtnEdit" Content="Edit Selected" Margin="0,0,6,0" Click="BtnEditSelectedRequiredItem_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemoveSelectedRequiredItem_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>

            <!-- Input Area -->
            <Grid Grid.Row="2" Margin="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: List -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnAdd" Content="Add Selected" Margin="0,0,3,10" Click="BtnAddRequiredItem_Click"
                            Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="1" x:Name="BtnAddAll" Content="(Un)Select All" Margin="3,0,0,10" Click="BtnAddAll_Click"
                            Style="{StaticResource PrimaryButton}"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,6,0">
                        <ListBox x:Name="LstAcceptedItems" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch"
                                 Style="{StaticResource MaterialDesignListBox}" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                        <TextBlock Text="{Binding}" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- Middle Column: Inputs -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0" Padding="12">
                    <StackPanel>
                        <TextBox x:Name="TxtSearch" Margin="0,0,0,8" Height="36" Padding="8"
                                 Text="" Style="{StaticResource CompactTextBox}"
                                 materialDesign:HintAssist.Hint="Type to search items..."
                                 TextChanged="TxtSearch_TextChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Label Content="Required:" HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource CompactLabel}"/>
                            <TextBox x:Name="TxtRequiredQty" Text="1" Width="70"
                                     Style="{StaticResource CompactTextBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Label Content="Random:" HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource CompactLabel}"/>
                            <TextBox x:Name="TxtRandomQty" Text="0" Width="70"
                                     Style="{StaticResource CompactTextBox}"/>
                        </StackPanel>

                        <TextBlock Text="Item Condition" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,10,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkMinHealth" Grid.Row="0" Grid.Column="0" Content="Min Health %" Margin="0,8,12,2"/>
                            <TextBox x:Name="TxtMinHealth" Grid.Row="0" Grid.Column="1" Text="50" Width="70" Margin="12,2,0,2"
                                     Style="{StaticResource CompactTextBox}"/>

                            <CheckBox x:Name="ChkMinUses" Grid.Row="1" Grid.Column="0" Content="Min Uses" Margin="0,8,12,2"/>
                            <TextBox x:Name="TxtMinUses" Grid.Row="1" Grid.Column="1" Text="1" Width="70" Margin="12,2,0,2"
                                     Style="{StaticResource CompactTextBox}"/>

                            <CheckBox x:Name="ChkMinMass" Grid.Row="2" Grid.Column="0" Content="Min Mass (g)" Margin="0,8,12,2"/>
                            <TextBox x:Name="TxtMinMass" Grid.Row="2" Grid.Column="1" Text="100" Width="70" Margin="12,2,0,2"
                                     Style="{StaticResource CompactTextBox}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Right Column: Properties -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Cooking Properties" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkMinCookLevel" Grid.Row="0" Grid.Column="0" Content="Min Cook Level" Margin="0,8,12,2"/>
                            <ComboBox x:Name="CmbMinCookLevel" Grid.Row="0" Grid.Column="1" Width="110" Margin="12,2,0,2">
                                <ComboBoxItem Content="Raw" />
                                <ComboBoxItem Content="Undercooked" />
                                <ComboBoxItem Content="Cooked" />
                                <ComboBoxItem Content="Overcooked" />
                                <ComboBoxItem Content="Burned" />
                            </ComboBox>

                            <CheckBox x:Name="ChkMaxCookLevel" Grid.Row="1" Grid.Column="0" Content="Max Cook Level" Margin="0,8,12,2"/>
                            <ComboBox x:Name="CmbMaxCookLevel" Grid.Row="1" Grid.Column="1" Width="110" Margin="12,2,0,2">
                                <ComboBoxItem Content="Raw" />
                                <ComboBoxItem Content="Undercooked" />
                                <ComboBoxItem Content="Cooked" />
                                <ComboBoxItem Content="Overcooked" />
                                <ComboBoxItem Content="Burned" />
                            </ComboBox>

                            <CheckBox x:Name="ChkMinCookQuality" Grid.Row="2" Grid.Column="0" Content="Min Cook Quality" Margin="0,8,12,2"/>
                            <ComboBox x:Name="CmbMinCookQuality" Grid.Row="2" Grid.Column="1" Width="110" Margin="12,2,0,2">
                                <ComboBoxItem Content="Ruined" />
                                <ComboBoxItem Content="Bad" />
                                <ComboBoxItem Content="Poor" />
                                <ComboBoxItem Content="Good" />
                                <ComboBoxItem Content="Excellent" />
                                <ComboBoxItem Content="Perfect" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Resource Properties" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,10,0,6"/>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ChkMinResourcePct" Grid.Row="0" Grid.Column="0" Content="Min Resource (%)" Margin="0,8,12,2"/>
                            <TextBox x:Name="TxtMinResourcePct" Grid.Row="0" Grid.Column="1" Text="50" Width="70" Margin="12,2,0,2"
                                     Style="{StaticResource CompactTextBox}"/>

                            <CheckBox x:Name="ChkMinResourceMl" Grid.Row="1" Grid.Column="0" Content="Min Resource (ml)" Margin="0,8,12,2"/>
                            <TextBox x:Name="TxtMinResourceMl" Grid.Row="1" Grid.Column="1" Text="100" Width="70" Margin="12,2,0,2"
                                     Style="{StaticResource CompactTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- OK/Cancel -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,8">
                <StackPanel x:Name="EditButtonsPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                    <Button x:Name="BtnApply" Content="Apply" Margin="0,0,8,0" Click="BtnApply_Click"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnCancelEdit" Content="Cancel Edit" Click="BtnCancelEdit_Click"
                            Style="{StaticResource SubtleButton}"/>
                </StackPanel>
                <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
</Window>
