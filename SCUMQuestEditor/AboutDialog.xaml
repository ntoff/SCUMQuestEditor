<Window x:Class="SCUMQuestEditor.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderPanel" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Image Width="64" Height="64" Margin="0,0,0,12" x:Name="ImgIcon"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SCUM Quest Editor" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
                <TextBlock x:Name="LblVersion" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="LblBuildDate" FontSize="12" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
                        <Hyperlink NavigateUri="https://github.com/ntoff/SCUMQuestEditor" RequestNavigate="OpenGithubLink">
                            https://github.com/ntoff/SCUMQuestEditor
                        </Hyperlink>
                        <LineBreak/>
                        <Run Text="This program and its creator are not associated with Gamepires."/>
                        <LineBreak/>
                        <Run Text="SCUM is copyright Gamepires."/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="OK"
                        Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
