<Window x:Class="SCUMQuestEditor.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="200"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderPanel" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Image Width="64" Height="64" Margin="0,0,0,12" x:Name="ImgIcon"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="SCUM Quest Editor" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock x:Name="LblVersion" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCheckUpdates" Content="Check Updates" FontSize="10" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="BtnCheckUpdates_Click"/>
                </StackPanel>
                <TextBlock x:Name="LblBuildDate" FontSize="12" Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center">
                        <Hyperlink NavigateUri="https://github.com/ntoff/SCUMQuestEditor" RequestNavigate="OpenGithubLink">
                            https://github.com/ntoff/SCUMQuestEditor
                        </Hyperlink>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="This program and its creator are not associated with Gamepires."/>
                        <LineBreak/>
                        <Run Text="SCUM is copyright Gamepires."/>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="This program is provided for free for non-commercial use."/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="OK"
                        Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
