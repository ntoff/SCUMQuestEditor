<Window x:Class="SCUMQuestEditor.EditMapLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Map Locations" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ListView -->
        <ListView x:Name="LocationList" Grid.Row="0" Margin="5"
                  Style="{StaticResource MaterialDesignListView}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="X" Width="80" DisplayMemberBinding="{Binding Location.X}" />
                    <GridViewColumn Header="Y" Width="80" DisplayMemberBinding="{Binding Location.Y}" />
                    <GridViewColumn Header="Z" Width="80" DisplayMemberBinding="{Binding Location.Z}" />
                    <GridViewColumn Header="Size Factor" Width="80" DisplayMemberBinding="{Binding SizeFactor}" />
                    <GridViewColumn Header="Format" Width="150" DisplayMemberBinding="{Binding FormatString}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 2. Location String Input -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Location String (copy from game):" HorizontalAlignment="Left"/>
            <TextBox x:Name="TxtLocationString" Grid.Column="0" Grid.Row="1" Margin="0,5,0,5" 
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource CompactTextBox}"/>
            <Button x:Name="BtnParse" Grid.Column="1" Content="Parse" Width="75" Margin="10,0,0,0" 
                    Click="BtnParse_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </Grid>

        <!-- 3. Manual Input Label -->
        <Label Grid.Row="2" Content="Or enter coordinates manually:" Margin="10,10,0,5"/>

        <!-- 4. Manual Input Controls -->
        <Grid Grid.Row="3" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="X Coordinate:" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="TxtX" Grid.Row="0" Grid.Column="1" Margin="0,5,10,5" Width="100" TextAlignment="Right"
                     Style="{StaticResource CompactTextBox}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Y Coordinate:" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="TxtY" Grid.Row="1" Grid.Column="1" Margin="0,5,10,5" Width="100" TextAlignment="Right"
                     Style="{StaticResource CompactTextBox}"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Z Coordinate:" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="TxtZ" Grid.Row="2" Grid.Column="1" Margin="0,5,10,5" Width="100" TextAlignment="Right"
                     Style="{StaticResource CompactTextBox}"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Size Factor:" HorizontalAlignment="Right" Margin="0,5,10,5"/>
            <TextBox x:Name="TxtSizeFactor" Grid.Row="3" Grid.Column="1" Margin="0,5,10,5" Width="100" TextAlignment="Right"
                     Style="{StaticResource CompactTextBox}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" 
                       Text="Size Factor determines the radius of the circle shown on the game map. A value of 1.0 is approximately 300m diameter." 
                       TextWrapping="Wrap" Margin="10,5,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}" 
                       FontSize="10" VerticalAlignment="Top"/>
        </Grid>

        <!-- 5. Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10,0,10,5">
            <Button x:Name="BtnAddUpdate" Content="Add/Update" Width="100" Margin="0,0,5,0" Click="BtnAddUpdate_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="BtnEditSelected" Content="Edit Selected" Width="100" Margin="0,0,5,0" Click="BtnEditSelected_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="BtnRemoveSelected" Content="Remove Selected" Width="100" Click="BtnRemoveSelected_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- 6. OK/Cancel -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5,10,10">
            <Button x:Name="BtnOk" Content="OK" Width="75" Height="25" Margin="0,0,10,0" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="75" Height="25" Click="BtnCancel_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
