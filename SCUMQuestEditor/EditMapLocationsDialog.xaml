<Window x:Class="SCUMQuestEditor.EditMapLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Map Locations" Height="540" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ListView -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8,8,8,4" Padding="0">
                <ListView x:Name="LocationList" Margin="4" Style="{StaticResource MaterialDesignListView}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="X" DisplayMemberBinding="{Binding Location.X}" />
                            <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Location.Y}" />
                            <GridViewColumn Header="Z" DisplayMemberBinding="{Binding Location.Z}" />
                            <GridViewColumn Header="Size Factor" DisplayMemberBinding="{Binding SizeFactor}" />
                            <GridViewColumn Header="Format" DisplayMemberBinding="{Binding FormatString}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Location String Input -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="8,8,8,4" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtLocationString" Grid.Column="0" Margin="0"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="Location String (copy from game):"
                             Style="{StaticResource CompactTextBox}"/>
                    <Button x:Name="BtnParse" Grid.Column="1" Content="Parse" Width="70" Margin="8,0,0,0"
                            Click="BtnParse_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Border>

            <!-- Manual Input -->
            <TextBlock Grid.Row="2" Text="Or enter coordinates manually:" Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="8,8,0,6" FontSize="12"/>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="8,0,8,8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="X Coordinate:" HorizontalAlignment="Right" Margin="0,4,12,4" Style="{StaticResource CompactLabel}"/>
                    <TextBox x:Name="TxtX" Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" Width="100" HorizontalAlignment="Right" TextAlignment="Right"
                             Style="{StaticResource CompactTextBox}"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Y Coordinate:" HorizontalAlignment="Right" Margin="0,4,12,4" Style="{StaticResource CompactLabel}"/>
                    <TextBox x:Name="TxtY" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" Width="100" HorizontalAlignment="Right" TextAlignment="Right"
                             Style="{StaticResource CompactTextBox}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Z Coordinate:" HorizontalAlignment="Right" Margin="0,4,12,4" Style="{StaticResource CompactLabel}"/>
                    <TextBox x:Name="TxtZ" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" Width="100" HorizontalAlignment="Right" TextAlignment="Right"
                             Style="{StaticResource CompactTextBox}"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Size Factor:" HorizontalAlignment="Right" Margin="0,4,12,4" Style="{StaticResource CompactLabel}"/>
                    <TextBox x:Name="TxtSizeFactor" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" Width="100" HorizontalAlignment="Right" TextAlignment="Right"
                             Style="{StaticResource CompactTextBox}"/>

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                               Text="Size Factor determines the radius of the circle shown on the game map. A value of 1.0 is approximately 300m diameter."
                               TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="10"/>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="8,8,8,8">
                <Button x:Name="BtnAddUpdate" Content="Add/Update" Margin="0,0,6,0" Click="BtnAddUpdate_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnEditSelected" Content="Edit Selected" Margin="0,0,6,0" Click="BtnEditSelected_Click"
                        Style="{StaticResource SubtleButton}"/>
                <Button x:Name="BtnRemoveSelected" Content="Remove Selected" Click="BtnRemoveSelected_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>

            <!-- OK/Cancel -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,8">
                <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
