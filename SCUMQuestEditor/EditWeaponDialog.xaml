<Window x:Class="SCUMQuestEditor.EditWeaponDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Allowed Weapons" Height="540" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8">
                <TextBox x:Name="TxtSearch" Margin="0" Padding="8"
                          Style="{StaticResource MaterialDesignTextBox}"
                          materialDesign:HintAssist.Hint="Type to search weapons..."
                          TextChanged="TxtSearch_TextChanged"/>
            </Border>

            <Border Grid.Row="1" Margin="8" Style="{StaticResource CardStyle}" Padding="0">
                <ListBox x:Name="LstWeapons" Margin="4"
                 SelectionMode="Multiple"
                 Style="{StaticResource MaterialDesignListBox}">
                    <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                            <TextBlock Text="{Binding}" />
                        </CheckBox>
                    </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="8,8,8,8">
                <Button x:Name="BtnOk" Content="OK"
                        Margin="0,0,10,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
