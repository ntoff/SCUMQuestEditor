<Application x:Class="SCUMQuestEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SCUMQuestEditor"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="LightBlue" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

                <!-- 1. Compact Label Style -->
                <Style x:Key="CompactLabel" TargetType="Label" BasedOn="{StaticResource MaterialDesignLabel}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="0,0,10,5" />
                    <Setter Property="Padding" Value="0" />
                </Style>

                <!-- 2. Compact TextBox Style -->
                <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>

                <!-- 3. Compact ComboBox Style -->
                <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="2,2,2,2" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>

                <!-- 4. Compact TabItem Header -->
                <Style x:Key="CompactTabItem" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Padding" Value="0,2,0,2" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

                <Style TargetType="Label" BasedOn="{StaticResource MaterialDesignLabel}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="0,0,10,5" />
                    <Setter Property="Padding" Value="0,5,0,0" />
                </Style>

                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>

                <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>

                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

            <!-- 5. Compact Button Style with Reduced Padding -->
            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,5,5" />
            </Style>

            <!-- 6. LISTBOX/LISTVIEW STYLE -->
            <!-- This gives the list a slightly lighter background and a clear border -->
            <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="2" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="White" />
            </Style>


        </ResourceDictionary>
    </Application.Resources>

</Application>
