<Window x:Class="SCUMQuestEditor.AddSkillRewardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Skill Reward" Height="180" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Skill:"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,12,6" Style="{StaticResource CompactLabel}"/>

            <ComboBox x:Name="CbSkill" Grid.Row="0" Grid.Column="1"
                      Margin="0,0,0,8"
                      Style="{StaticResource CompactComboBox}">
                <ComboBoxItem Content="Archery" />
                <ComboBoxItem Content="Aviation" />
                <ComboBoxItem Content="Awareness" />
                <ComboBoxItem Content="Boxing" />
                <ComboBoxItem Content="Camouflage" />
                <ComboBoxItem Content="Cooking" />
                <ComboBoxItem Content="Demolition" />
                <ComboBoxItem Content="Driving" />
                <ComboBoxItem Content="Endurance" />
                <ComboBoxItem Content="Engineering" />
                <ComboBoxItem Content="Farming" />
                <ComboBoxItem Content="Handgun" />
                <ComboBoxItem Content="Medical" />
                <ComboBoxItem Content="MeleeWeapons" />
                <ComboBoxItem Content="Motorcycle" />
                <ComboBoxItem Content="Rifles" />
                <ComboBoxItem Content="Running" />
                <ComboBoxItem Content="Sniping" />
                <ComboBoxItem Content="Stealth" />
                <ComboBoxItem Content="Survival" />
                <ComboBoxItem Content="Thievery" />
            </ComboBox>

            <Label Grid.Row="1" Grid.Column="0" Content="Experience:"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,12,6" Style="{StaticResource CompactLabel}"/>

            <TextBox x:Name="TxtExperience" Grid.Row="1" Grid.Column="1"
                     Margin="0,0,0,8"
                     Style="{StaticResource CompactTextBox}"/>

            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnOk" Content="OK"
                        Margin="0,0,8,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
