<Window x:Class="SCUMQuestEditor.FilenameFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Filename Format Settings" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" MaxWidth="480" VerticalAlignment="Top">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Grid.Row="0" Padding="8">
                    <TextBox x:Name="TxtFormat" Grid.Row="0" Margin="0" Padding="8"
                              Style="{StaticResource MaterialDesignTextBox}"
                              materialDesign:HintAssist.Hint="T{tier}_{trader}_{title}"
                              FontFamily="Consolas"/>
                </Border>

                <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,16,0,16" Padding="12">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="Available placeholders:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="  {tier} - Quest tier (1, 2, 3, 4)" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="  {trader} - Trader code (AR, BK, BA, BT, DC, GG, HM, RH, MH, MC)" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="  {title} - Quest title (spaces replaced with underscores)" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Text="  {type} - Quest type (Eliminate, Fetch, Interact, Mixed)" Margin="0,0,0,4"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0"
                            Click="BtnOk_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,10,0"
                            Click="BtnCancel_Click" Style="{StaticResource SubtleButton}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
