<Window x:Class="SCUMQuestEditor.AddTradeDealDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Trade Deal" Height="700" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}" Grid.Row="0" Grid.ColumnSpan="2" Padding="8">
                <TextBox x:Name="TxtSearch" Margin="0" Padding="8"
                         Style="{StaticResource MaterialDesignTextBox}"
                         materialDesign:HintAssist.Hint="Type to search items..."
                         TextChanged="TxtSearch_TextChanged"/>
            </Border>

            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Grid.ColumnSpan="2" Padding="0" Margin="0,12,0,0">
                <ListBox x:Name="LstItems" Margin="4"
                         Style="{StaticResource MaterialDesignListBox}"
                         HorizontalContentAlignment="Stretch"/>
            </Border>

            <Label Grid.Row="2" Grid.Column="0" Content="Price:"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,12,12,6" Style="{StaticResource CompactLabel}"/>
            <TextBox x:Name="TxtPrice" Grid.Row="2" Grid.Column="1"
                     Margin="0,0,0,8" Text="50"
                     Style="{StaticResource CompactTextBox}"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Amount:"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,12,12,6" Style="{StaticResource CompactLabel}"/>
            <TextBox x:Name="TxtAmount" Grid.Row="3" Grid.Column="1"
                     Margin="0,0,0,8" Text="1"
                     Style="{StaticResource CompactTextBox}"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Fame Required:"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,12,12,6" Style="{StaticResource CompactLabel}"/>
            <TextBox x:Name="TxtFame" Grid.Row="4" Grid.Column="1"
                     Margin="0,0,0,8" Text="25"
                     Style="{StaticResource CompactTextBox}"/>

            <Border Grid.Row="5" Grid.ColumnSpan="2" Background="{DynamicResource MaterialDesignDivider}" Height="1" Margin="0,8,0,8"/>

            <CheckBox x:Name="ChkAllowExcluded" Grid.Row="6" Grid.ColumnSpan="2"
                      Content="Allow Excluded" IsChecked="True"
                      Margin="0,4,0,0" HorizontalAlignment="Left"
                      Style="{StaticResource MaterialDesignCheckBox}"/>

            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnOk" Content="OK"
                        Margin="0,0,8,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel"
                        Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
