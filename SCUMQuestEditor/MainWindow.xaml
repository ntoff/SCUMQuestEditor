<Window x:Class="TabbedApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCUM Quest Editor" Height="750" Width="850"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="MenuItem_New_Click" />
                <MenuItem Header="_Open" Click="MenuItem_Open_Click" />
                <MenuItem Header="_Save" Click="MenuItem_Save_Click" />
            </MenuItem>
        </Menu>

        <!-- Tab Control -->
        <TabControl Margin="8">

            <!-- TAB 1: Basic Info -->
            <TabItem Header="Basic Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <!-- Grid Definition: 2 Columns (Labels, Inputs) -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Rows -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 2. Associated NPC -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Associated NPC:" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox x:Name="CbNpc" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" SelectedIndex="0" 
                                  SelectionChanged="CbNpc_SelectionChanged">
                            <ComboBoxItem Content="Armorer" />
                            <ComboBoxItem Content="Banker" />
                            <ComboBoxItem Content="Barber" />
                            <ComboBoxItem Content="Bartender" />
                            <ComboBoxItem Content="Doctor" />
                            <ComboBoxItem Content="General Goods" />
                            <ComboBoxItem Content="Harbourmaster" />
                            <ComboBoxItem Content="Mechanic" />
                        </ComboBox>

                        <!-- 1. Quest Title -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Quest Title:" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTitle" Grid.Row="1" Grid.Column="1" Text="New Quest" 
                            Margin="0,0,0,10" IsReadOnly="False" 
                            TextChanged="TxtInput_TextChanged"/>

                        <!-- 3. Tier (1-3) -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Tier (1-3):" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTier" Grid.Row="2" Grid.Column="1" Text="1" 
                                 Margin="0,0,0,10" TextAlignment="Left" 
                                 TextChanged="TxtInput_TextChanged"
                                 PreviewTextInput="NumericPreviewTextInput"
                                 DataObject.Pasting="NumericPasting"/>

                        <!-- 4. Quest Description -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Quest Description:" 
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtDescription" Grid.Row="3" Grid.Column="1" 
                                 Text="Quest description..." 
                                 Margin="0,0,0,10" Height="80" AcceptsReturn="True" 
                                 TextWrapping="Wrap" IsReadOnly="False"
                                 TextChanged="TxtInput_TextChanged"/>

                        <!-- 5. Time Limit (hours) -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Time Limit (hours):" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTimeLimit" Grid.Row="4" Grid.Column="1" Text="0.5" 
                                 Margin="0,0,0,10" TextAlignment="Left" 
                                 TextChanged="TxtInput_TextChanged"
                                 PreviewTextInput="FloatPreviewTextInput"
                                 DataObject.Pasting="FloatPasting"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Rewards -->
            <TabItem Header="Rewards">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Currency Section -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Normal Currency:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtNormalReward" Grid.Row="0" Grid.Column="1" Text="0" Margin="0,0,0,5" 
                                     TextChanged="TxtInput_TextChanged"
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Gold Currency:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtGoldReward" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,0,0,5" 
                                     TextChanged="TxtInput_TextChanged"
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Fame:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtFameReward" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,0,0,5" 
                                     TextChanged="TxtInput_TextChanged"
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>
                        </Grid>

                        <!-- Skills Section -->
                        <Label Content="Skills:" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                        <Button Content="Add Skill Reward" Margin="0,0,0,5" Click="BtnAddSkillReward_Click"/>

                        <ListView x:Name="LvSkills" Height="150" Margin="0,0,0,5" BorderBrush="Gray" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Skill" DisplayMemberBinding="{Binding Skill}" Width="150"/>
                                    <GridViewColumn Header="Experience" DisplayMemberBinding="{Binding Experience}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Remove Selected Skill" Margin="0,0,0,10" Click="BtnRemoveSelectedSkill_Click"/>

                        <!-- Trade Deals Section -->
                        <Label Content="Trade Deals:" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                        <Button Content="Add Trade Deal" Margin="0,0,0,5" Click="BtnAddTradeDeal_Click"/>

                        <ListView x:Name="LvTradeDeals" Height="150" Margin="0,0,0,5" BorderBrush="Gray" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Item}" Width="120"/>
                                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" Width="80"/>
                                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding Amount}" Width="60"/>
                                    <GridViewColumn Header="Fame" DisplayMemberBinding="{Binding Fame}" Width="60"/>
                                    <GridViewColumn Header="Allow Excluded" DisplayMemberBinding="{Binding AllowExcluded}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Remove Selected Trade Deal" Margin="0,0,0,10" Click="BtnRemoveSelectedTradeDeal_Click"/>

                        <!-- Total Rewards -->
                        <TextBlock x:Name="TxtTotalRewards" Text="Total Rewards: 0/5" 
                                   HorizontalAlignment="Right" Margin="0,10,0,0" FontWeight="Bold"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Conditions -->
            <TabItem Header="Conditions">
                <DockPanel Margin="10">

                    <!-- Top Section: ListView -->
                    <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
                        <ListView x:Name="LvConditions" BorderThickness="0" SelectionMode="Single" Height="180">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}" />
                                    <GridViewColumn Header="Caption" Width="200" DisplayMemberBinding="{Binding Caption}" />
                                    <GridViewColumn Header="Sequence" Width="100" DisplayMemberBinding="{Binding Sequence}" />
                                    <GridViewColumn Header="Auto Complete" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding AutoComplete}" IsEnabled="False" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Details" Width="200" DisplayMemberBinding="{Binding Details}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Middle Section: Buttons -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Elimination" Width="120" Margin="0,0,5,0" Click="BtnAddElimination_Click"/>
                        <Button Content="Add Fetch Condition" Width="140" Margin="0,0,5,0" Click="BtnAddFetchCondition_Click"/>
                        <Button Content="Add Interaction" Width="120" Margin="0,0,5,0" Click="BtnAddInteraction_Click"/>
                        <Button Content="Remove Selected" Width="120" Click="BtnRemoveSelectedCondition_Click"/>
                    </StackPanel>

                    <!-- Bottom Section: Instruction Text -->
                    <TextBlock DockPanel.Dock="Bottom" Text="Double-click on a condition in the list above to edit it." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/>

                </DockPanel>
            </TabItem>

            <!-- TAB 4: JSON Preview -->
            <TabItem Header="JSON Preview">
                <TextBox x:Name="TxtJson" Margin="8" 
                         Text="" 
                         TextWrapping="Wrap" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
