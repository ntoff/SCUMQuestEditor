<Window x:Class="SCUMQuestEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av"
        Title="SCUM Quest Editor" Height="830" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignPaper}">
            <MenuItem Header="_File" Foreground="{DynamicResource MaterialDesignBody}">
                <MenuItem Header="_New" Click="MenuItem_New_Click" />
                <MenuItem Header="_Open" Click="MenuItem_Open_Click" />
                <MenuItem Header="_Save" Click="MenuItem_Save_Click" />
            </MenuItem>
        </Menu>

        <!-- Tab Control - Standard style, not NavigationRail -->
        <TabControl Margin="8" Background="{DynamicResource MaterialDesignPaper}">

            <!-- TAB 1: Basic Info -->
            <TabItem Header="Basic Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 2. Associated NPC -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Associated NPC:" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <ComboBox x:Name="CbNpc" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" SelectedIndex="0" 
                                  SelectionChanged="CbNpc_SelectionChanged">
                            <ComboBoxItem Content="Armorer" />
                            <ComboBoxItem Content="Banker" />
                            <ComboBoxItem Content="Barber" />
                            <ComboBoxItem Content="Bartender" />
                            <ComboBoxItem Content="Doctor" />
                            <ComboBoxItem Content="GeneralGoods" />
                            <ComboBoxItem Content="Harbourmaster" />
                            <ComboBoxItem Content="Hunter" />
                            <ComboBoxItem Content="Mechanic" />
                        </ComboBox>

                        <!-- 1. Quest Title -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Quest Title:" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTitle" Grid.Row="1" Grid.Column="1" Text="New Quest" 
                            Margin="0,0,0,5" IsReadOnly="False"
                            TextChanged="TxtInput_TextChanged"/>

                        <!-- 3. Tier (1-3) -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Tier (1-3):" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTier" Grid.Row="2" Grid.Column="1" Text="1" 
                                 Margin="0,0,0,5" TextAlignment="Left" 
                                 PreviewTextInput="NumericPreviewTextInput"
                                 DataObject.Pasting="NumericPasting"
                                 TextChanged="TxtInput_TextChanged"/>

                        <!-- 4. Quest Description -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Quest Description:" 
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtDescription" Grid.Row="3" Grid.Column="1" 
                                 Text="Quest description..." 
                                 Margin="0,0,0,5" Height="80" AcceptsReturn="True" 
                                 TextWrapping="Wrap" IsReadOnly="False"
                                 TextChanged="TxtInput_TextChanged"/>

                        <!-- 5. Time Limit (hours) -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Time Limit (hours):" 
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,10"/>
                        <TextBox x:Name="TxtTimeLimit" Grid.Row="4" Grid.Column="1" Text="0.5" 
                                 Margin="0,0,0,10" TextAlignment="Left" 
                                 PreviewTextInput="FloatPreviewTextInput" DataObject.Pasting="FloatPasting"
                                 TextChanged="TxtInput_TextChanged"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Rewards -->
            <TabItem Header="Rewards">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- Currency Section -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Normal Currency:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtNormalReward" Grid.Row="0" Grid.Column="1" Text="0" Margin="0,0,0,0"
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"
                                     TextChanged="TxtInput_TextChanged"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Gold Currency:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtGoldReward" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,0,0,0" 
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"
                                     TextChanged="TxtInput_TextChanged"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Fame:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                            <TextBox x:Name="TxtFameReward" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,0,0,0" 
                                     PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"
                                     TextChanged="TxtInput_TextChanged"/>
                        </Grid>

                        <!-- Skills Section -->
                        <Label Content="Skills:" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                        <Button Content="Add Skill Reward" Margin="0,0,0,5" Click="BtnAddSkillReward_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <ListView x:Name="LvSkills" Height="150" Margin="0,0,0,5"
                                  MouseDoubleClick="LvSkills_MouseDoubleClick" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Skill" DisplayMemberBinding="{Binding Skill}"/>
                                    <GridViewColumn Header="Experience" DisplayMemberBinding="{Binding Experience}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Remove Selected Skill" Margin="0,0,0,10" Click="BtnRemoveSelectedSkill_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <!-- Trade Deals Section -->
                        <Label Content="Trade Deals:" HorizontalAlignment="Left" Margin="0,5,0,5"/>
                        <Button Content="Add Trade Deal" Margin="0,0,0,5" Click="BtnAddTradeDeal_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <ListView x:Name="LvTradeDeals" Height="150" Margin="0,0,0,5"
                                  MouseDoubleClick="LvTradeDeals_MouseDoubleClick" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Item" DisplayMemberBinding="{Binding Item}" />
                                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" />
                                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding Amount}" />
                                    <GridViewColumn Header="Fame" DisplayMemberBinding="{Binding Fame}" />
                                    <GridViewColumn Header="Allow Excluded" DisplayMemberBinding="{Binding AllowExcluded}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Remove Selected Trade Deal" Margin="0,0,0,10" Click="BtnRemoveSelectedTradeDeal_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                        <!-- Total Rewards -->
                        <TextBlock x:Name="TxtTotalRewards" Text="Total Rewards: 0/5" 
                                   HorizontalAlignment="Right" Margin="0,10,0,0" FontWeight="Bold"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Conditions -->
            <TabItem Header="Conditions">
                <DockPanel Margin="10">

                    <!-- Top Section: ListView -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,10">
                        <ListView x:Name="LvConditions" BorderThickness="0" SelectionMode="Single" Height="180" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}" />
                                    <GridViewColumn Header="Caption" Width="200" DisplayMemberBinding="{Binding TrackingCaption}" />
                                    <GridViewColumn Header="Sequence" DisplayMemberBinding="{Binding SequenceIndex}" />
                                    <GridViewColumn Header="Auto Complete">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding CanBeAutoCompleted}" IsEnabled="False"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Middle Section: Buttons -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Add Elimination" Margin="0,0,5,0" Click="BtnAddElimination_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Content="Add Fetch Condition" Margin="0,0,5,0" Click="BtnAddFetchCondition_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Content="Add Interaction"  Margin="0,0,5,0" Click="BtnAddInteraction_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Content="Remove Selected" Click="BtnRemoveSelectedCondition_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>

                    <!-- Bottom Section: Condition Editor -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <TabControl x:Name="TabConditionEditor" Margin="0,5,0,0" SelectionChanged="TabConditionEditor_SelectionChanged">
                            <!-- Common Properties Tab -->
                            <TabItem Header="Common Properties">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Caption:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <TextBox x:Name="EdtCaption" Grid.Row="0" Grid.Column="1" Margin="0,0,0,0"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Sequence:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <TextBox x:Name="EdtSequence" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Auto Complete:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <CheckBox x:Name="EdtAutoComplete" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" 
                                              IsChecked="False"/>
                                </Grid>
                            </TabItem>

                            <!-- Elimination Properties Tab -->
                            <TabItem Header="Elimination Properties" x:Name="TabEliminationProperties">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Target Characters -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Target Characters:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <Button Grid.Row="0" Grid.Column="1" Content="Edit Targets" Margin="0,0,0,5" Click="BtnEditEliminationTargets_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                                        <Label Grid.Row="1" Grid.Column="0" Content="Current Targets:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <ListBox Grid.Row="1" Grid.Column="1" x:Name="EdtEliminationTargets" Margin="0,0,0,5" Height="120"
                                            Style="{StaticResource MaterialDesignListBox}"/>

                                        <!-- Kill Amount -->
                                        <Label Grid.Row="2" Grid.Column="0" Content="Amount to Kill:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <TextBox x:Name="EdtKillAmount" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" Text="1" 
                                            TextChanged="EdtKillAmount_TextChanged"
                                            PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>

                                        <!-- Allowed Weapons -->
                                        <Label Grid.Row="3" Grid.Column="0" Content="Allowed Weapons:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <Button Grid.Row="3" Grid.Column="1" Content="Edit Weapons" Margin="0,0,0,5" Click="BtnEditEliminationWeapons_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                                        <Label Grid.Row="4" Grid.Column="0" Content="Current Weapons:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <ListBox Grid.Row="4" Grid.Column="1" x:Name="EdtAllowedWeapons" Margin="0,0,0,5" Height="120"
                                            Style="{StaticResource MaterialDesignListBox}"/>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Fetch Properties Tab -->
                            <TabItem Header="Fetch Properties" x:Name="TabFetchProperties">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Player Keeps Items:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <CheckBox x:Name="ChkPlayerKeepsItems" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Disable Purchase:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <CheckBox x:Name="ChkDisablePurchase" Grid.Row="1" Grid.Column="1" Margin="0,5,0,5" IsChecked="True" />

                                    <Label Grid.Row="2" Grid.Column="0" Content="Required Items:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <Button x:Name="BtnEditRequiredItems" Grid.Row="2" Grid.Column="1" Content="Edit Required Items" Margin="0,0,0,5" 
                                            Click="BtnEditRequiredItems_Click" Height="25"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Current Required Items:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                    <ListView x:Name="LvCurrentRequiredItems" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5" Height="150" 
                                              Style="{StaticResource MaterialDesignListView}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Items" DisplayMemberBinding="{Binding ItemName}" />
                                                <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding Quantity}" />
                                                <GridViewColumn Header="Properties" DisplayMemberBinding="{Binding Properties}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="The player must collect the specified items to complete this condition." Foreground="{DynamicResource MaterialDesignBody}" Margin="0,5,0,0" TextDecorations="Underline" VerticalAlignment="Bottom"/>
                                </Grid>
                            </TabItem>

                            <!-- Interaction Properties Tab -->
                            <TabItem Header="Interaction Properties" x:Name="TabInteractionProperties">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Spawn Only Needed -->
                                        <Label Grid.Row="0" Grid.Column="0" Content="Spawn Only Needed:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <CheckBox x:Name="ChkSpawnOnlyNeeded" Grid.Row="0" Grid.Column="1" Margin="0,5,0,5" 
                                                  IsChecked="True" />

                                        <!-- Min Needed -->
                                        <Label Grid.Row="1" Grid.Column="0" Content="Min Needed:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <TextBox x:Name="EdtMinNeeded" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Text="1"
                                                 PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>

                                        <!-- Max Needed -->
                                        <Label Grid.Row="2" Grid.Column="0" Content="Max Needed:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <TextBox x:Name="EdtMaxNeeded" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" Text="1"
                                                 PreviewTextInput="NumericPreviewTextInput" DataObject.Pasting="NumericPasting"/>

                                        <!-- Marker Show Distance -->
                                        <Label Grid.Row="3" Grid.Column="0" Content="Marker Show Distance:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <TextBox x:Name="EdtMarkerDistance" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5" Text="5"
                                                 PreviewTextInput="FloatPreviewTextInput" DataObject.Pasting="FloatPasting"/>

                                        <!-- Interaction Locations Button -->
                                        <Label Grid.Row="4" Grid.Column="0" Content="Interaction Locations:" HorizontalAlignment="Right" Margin="0,0,10,5"/>
                                        <Button x:Name="BtnEditInteractionLocations" Grid.Row="4" Grid.Column="1" Content="Edit Locations" Margin="0,0,0,5" 
                                                Click="BtnEditInteractionLocations_Click" Height="25"
                                                Style="{StaticResource MaterialDesignRaisedButton}"/>

                                        <!-- Info Text -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                                   Text="Use '#GetMeshInfo' in-game to get location data for real objects." 
                                                   Foreground="{DynamicResource MaterialDesignBody}" Margin="0,5,0,0" TextDecorations="Underline"/>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            

                            <!-- Map Locations Tab -->
                            <TabItem Header="Map Locations" x:Name="TabMapLocationsItem">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Content="Edit Map Locations" Click="BtnEditMapLocations_Click"
                                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    </StackPanel>

                                    <ListView x:Name="TabMapLocations" Grid.Row="1" Margin="0,10,0,0"
                                              Style="{StaticResource MaterialDesignListView}" av:ItemsSource="{av:SampleData ItemCount=5}" SelectionChanged="TabMapLocations_SelectionChanged">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="X" DisplayMemberBinding="{Binding Location.X}" />
                                                <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Location.Y}" />
                                                <GridViewColumn Header="Z" DisplayMemberBinding="{Binding Location.Z}" />
                                                <GridViewColumn Header="Size Factor" DisplayMemberBinding="{Binding SizeFactor}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="10,0,0,0">
                            <Button x:Name="BtnSaveCondition" Content="Update Details" Margin="0,0,0,5" 
                                    Click="BtnSaveCondition_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" FontSize="14"/>
                        </StackPanel>
                    </DockPanel>

                </DockPanel>
            </TabItem>

            <!-- TAB 4: JSON Preview -->
            <TabItem Header="JSON Preview">
                <TextBox x:Name="TxtJson" Margin="8" 
                         Text="" 
                         TextWrapping="Wrap" 
                         IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Top"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>