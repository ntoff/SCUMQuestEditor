<Window x:Class="SCUMQuestEditor.SaveValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Cannot Save Quest"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <Border Grid.Row="1"
                    Background="{DynamicResource MaterialDesignValidationErrorBrush}"
                    CornerRadius="8"
                    Opacity="0.15"
                    Margin="0,0,0,16"/>

            <TextBlock x:Name="TxtMessage" Grid.Row="1"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Margin="20,10"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOk" Content="OK" Width="80" Height="30"
                        Margin="0,0,8,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
