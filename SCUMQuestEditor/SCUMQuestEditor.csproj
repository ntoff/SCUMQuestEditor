<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>True</UseWPF>
    <NuGetAuditMode>all</NuGetAuditMode>
    <ApplicationIcon>ICON\icon.ico</ApplicationIcon>
    <UseWindowsForms>False</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ICON\icon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="_data\EliminationTargets.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="_data\EliminationWeapons.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="_data\FetchItems.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="_data\TradeItems.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    </ItemGroup>

  <Target Name="SetBuildDate" BeforeTargets="CoreCompile">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Scripts\UpdateBuildInfo.ps1&quot;" />
  </Target>

  <Target Name="ZipPublishOutput" AfterTargets="Publish">
    <PropertyGroup>
      <ZipTimestamp>$([System.DateTime]::Now.ToString('yyyyMMdd_HHmm'))</ZipTimestamp>
      <ZipFileName>SCUMQuestEditor_$(ZipTimestamp).zip</ZipFileName>
      <PkgDir>$(ProjectDir)..\packages</PkgDir>
    </PropertyGroup>
    <Exec Command="powershell -ExecutionPolicy Bypass -Command &quot;New-Item -ItemType Directory -Path '$(PkgDir)' -Force -ErrorAction SilentlyContinue; Compress-Archive -Path '$(PublishDir)*' -DestinationPath '$(PkgDir)\$(ZipFileName)' -Force&quot;" />
  </Target>
  
</Project>
