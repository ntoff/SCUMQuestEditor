<Window x:Class="SCUMQuestEditor.EditInteractionLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:SCUMQuestEditor"
        Title="Edit Interaction Locations" Height="640" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignBackground}"
        Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <local:StringNullOrEmptyToNullConverter x:Key="StringNullOrEmptyToNullConverter"/>
    </Window.Resources>

    <Border Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12">
        <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource MaterialDesignDividerColor}"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ListView -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="8,8,8,4" Padding="0">
                <ListView x:Name="LocationList" Margin="4" Style="{StaticResource MaterialDesignListView}"
                          BorderBrush="{DynamicResource MaterialDesignDivider}"
                          SelectionMode="Extended"
                          MouseDoubleClick="LocationList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Visible Mesh">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VisibleMesh}" ToolTip="{Binding AnchorMesh, Converter={StaticResource StringNullOrEmptyToNullConverter}}" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fallback Transform">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FallbackTransform}" ToolTip="{Binding AnchorMesh, Converter={StaticResource StringNullOrEmptyToNullConverter}}" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Has Anchor">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HasAnchor}" ToolTip="{Binding AnchorMesh, Converter={StaticResource StringNullOrEmptyToNullConverter}}" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Instance">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InstanceDisplay}" ToolTip="{Binding AnchorMesh, Converter={StaticResource StringNullOrEmptyToNullConverter}}" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,8,8,8">
                <Button x:Name="BtnEdit" Content="Edit Selected" Margin="0,0,6,0" Click="BtnEditSelectedLocation_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemoveSelectedLocation_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>

            <!-- Input Section -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="8,8,8,8" Padding="12">
                <StackPanel>
                    <TextBlock Text="#GetMeshInfo Output" Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtMeshInfoInput" Margin="0,0,0,8"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="120"
                             materialDesign:HintAssist.Hint="Paste #getmeshinfo output here"
                             Style="{StaticResource CompactTextBox}"/>

                    <TextBlock Text="Paste the complete output from the #GetMeshInfo command. Look at an object in-game and type #GetMeshInfo to get this data. The output is automatically copied to your clipboard when the command is executed."
                               TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnApply" Content="Apply / Add" Margin="0,0,8,0" Click="BtnApply_Click"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="BtnCancelInput" Content="Cancel" Click="BtnCancelInput_Click"
                                Style="{StaticResource SubtleButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OK/Cancel -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,8">
                <Button x:Name="BtnOk" Content="OK" Margin="0,0,10,0" Click="BtnOk_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                        Style="{StaticResource SubtleButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
