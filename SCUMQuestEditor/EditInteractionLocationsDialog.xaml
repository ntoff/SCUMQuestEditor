<Window x:Class="SCUMQuestEditor.EditInteractionLocationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Interaction Locations" Height="600" Width="1050"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ListView -->
        <ListView x:Name="LocationList" Grid.Row="0" Margin="5"
                  Style="{StaticResource MaterialDesignListView}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Visible Mesh" Width="200" DisplayMemberBinding="{Binding VisibleMesh}" />
                    <GridViewColumn Header="Fallback Transform" Width="200" DisplayMemberBinding="{Binding FallbackTransform}" />
                    <GridViewColumn Header="Has Anchor" DisplayMemberBinding="{Binding HasAnchor}" />
                    <!-- CHANGED: Bind to InstanceDisplay -->
                    <GridViewColumn Header="Instance" Width="80" DisplayMemberBinding="{Binding InstanceDisplay}" />
                </GridView>
            </ListView.View>

        </ListView>

        <!-- 2. Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,10,5">
            <Button x:Name="BtnEdit" Content="Edit Selected" Margin="0,0,5,0" Click="BtnEditSelectedLocation_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="BtnRemove" Content="Remove Selected" Click="BtnRemoveSelectedLocation_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- 3. Input Section -->
        <Grid Grid.Row="2" Margin="10,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="#GetMeshInfo Output:" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMeshInfoInput" Grid.Row="1" Margin="0,5,0,5" 
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="150"
                     materialDesign:HintAssist.Hint="Paste #getmeshinfo output here"
                     Style="{StaticResource CompactTextBox}"/>
            
            <TextBlock Grid.Row="2" Text="Paste the complete output from the #GetMeshInfo command. Look at an object in-game and type #GetMeshInfo to get this data. The output is automatically copied to your clipboard when the command is executed." 
                       TextWrapping="Wrap" Margin="0,5,0,5" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="10"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnApply" Content="Apply Edit / Add New" Margin="0,0,10,0" Click="BtnApply_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button x:Name="BtnCancelInput" Content="Cancel Edit" Click="BtnCancelInput_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>

        <!-- 4. OK/Cancel -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,10,10">
            <Button x:Name="BtnOk" Content="OK" Width="75" Height="25" Margin="0,0,10,0" Click="BtnOk_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="75" Height="25" Click="BtnCancel_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
